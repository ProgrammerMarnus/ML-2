                prefix_only=a.iloc[0].info_corroboration,full_history=b.iloc[0].info_corroboration,
                existing_leakage_probe_passed=gate['passed'])

def weekend_decay():
    idx=pd.bdate_range('2024-01-08',periods=15,tz='UTC')
