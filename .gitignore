```gitignore
# Compiled Python files
__pycache__/
*.pyc
*.pyo
*.pyd

# Build and distribution directories
dist/
build/
*.egg-info/

# Virtual environments
venv/
.venv/
env/
.ENV/

# Node.js dependencies
node_modules/

# Logs
*.log

# Temporary files
*.tmp
*.temp
*.swp
*.swo

# Environment variables
.env
.env.local
.env.*

# IDE specific files
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Data files (often large)
*.parquet
*.csv

# Coverage reports
.coverage
htmlcov/
coverage/

# Testing
.pytest_cache/
.hypothesis/

# Distribution artifacts
*.egg
*.whl

# Experimental data and logs
artifacts/
closed_strategies/
data/raw_snapshots/
data/research_ledgers/
```