artifacts_*/
data_cache/
logs/

# ---- Data snapshots ----
# Snapshots are a deliberate, reviewable commit: use `git add -f` for new ones.
data/raw_snapshots/*.meta.json
data/raw_snapshots/*.parquet
data/universe_*.csv

