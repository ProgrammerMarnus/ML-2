                    (p.loc[:t].tail(2).to_dict()|p.loc[t:].head(2).to_dict()).items()},
                'reported_metrics':summarize_experiment(result)}
        except Exception as exc:
            evidence[name]={'accepted':False,'error':str(exc),'type':type(exc).__name__}
