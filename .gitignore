```gitignore
# Python compiled files
*.pyc
__pycache__/

# Logs
*.log

# Artifacts and data
artifacts/
data/raw_snapshots/
logs/

# Dependencies (if any virtual environments exist)
.venv/
venv/
.env
.env.local
*.env.*

# Build/dist directories (if they exist)
dist/
build/
target/

# Coverage reports
.coverage
coverage/
htmlcov/

# Editors/IDE
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Research specific
src/quant_research.egg-info/
```